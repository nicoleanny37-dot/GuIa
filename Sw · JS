/* GuIa — Service Worker: faz o app abrir e funcionar sem internet.
   Tudo que o app precisa (código, paradas da linha 875C-10, ícones) fica em cache. */
const VERSION = 'guia-v11';
const SHELL = ['./', 'index.html', 'linha875c10.js', 'manifest.json', 'icon-192.png', 'icon-512.png', 'icon-180.png', 'icon-maskable-512.png'];

self.addEventListener('install', e => {
  e.waitUntil(caches.open(VERSION).then(c => Promise.all(SHELL.map(u => c.add(u).catch(() => {})))).then(() => self.skipWaiting()));
});
self.addEventListener('activate', e => {
  e.waitUntil(caches.keys().then(ks => Promise.all(ks.filter(k => k !== VERSION).map(k => caches.delete(k)))).then(() => self.clients.claim()));
});
self.addEventListener('fetch', e => {
  const r = e.request;
  if (r.method !== 'GET') return;
  const u = new URL(r.url);
  /* abrir o app: tenta a rede (versão nova) e, sem internet, usa o cache */
  if (r.mode === 'navigate') {
    e.respondWith(fetch(r).then(res => { const cp = res.clone(); caches.open(VERSION).then(c => c.put('index.html', cp)); return res; })
      .catch(() => caches.match('index.html').then(h => h || caches.match('./'))));
    return;
  }
  /* arquivos do próprio app: cache primeiro */
  if (u.origin === location.origin) {
    e.respondWith(caches.match(r).then(h => h || fetch(r).then(res => { const cp = res.clone(); caches.open(VERSION).then(c => c.put(r, cp)); return res; })));
    return;
  }
  /* fontes: guarda a primeira vez e reaproveita depois */
  if (/(^|\.)fonts\.(googleapis|gstatic)\.com$/.test(u.hostname)) {
    e.respondWith(caches.open(VERSION).then(c => c.match(r).then(h => {
      const net = fetch(r).then(res => { c.put(r, res.clone()); return res; }).catch(() => h);
      return h || net;
    })));
  }
});
