    TELEGRAM_WEBHOOK_SECRET: env.TELEGRAM_WEBHOOK_SECRET ? 'configurado' : 'FALTA (Secret)',
    SPTRANS_TOKEN: env.SPTRANS_TOKEN ? (String(env.SPTRANS_TOKEN) !== String(env.SPTRANS_TOKEN).trim() ? 'configurado, mas com espaço no começo ou no fim (o servidor já ignora o espaço)' : 'configurado') : 'FALTA (Secret)'
  };
  if (env.SPTRANS_TOKEN) {
    try {
      const a = await fetch(baseSpt(env) + '/Login/Autenticar?token=' + encodeURIComponent(String(env.SPTRANS_TOKEN).trim()), { method: 'POST' });
      const corpo = (await a.text()).trim().slice(0, 30), cookie = /apiCredentials=/.test(typeof a.headers.getSetCookie === 'function' ? a.headers.getSetCookie().join(';') : (a.headers.get('set-cookie') || ''));
      r.SPTrans_login = { http: a.status, resposta: corpo, cookie: cookie ? 'recebido' : 'não recebido', veredito: corpo === 'true' && cookie ? 'OK' : MOTIVOS[corpo === 'true' ? 'login_sem_cookie' : 'login_recusado'] };
    } catch (e) { r.SPTrans_login = { veredito: MOTIVOS.rede, detalhe: String((e && e.message) || e).slice(0, 80) }; }
  }
  if (env.TELEGRAM_BOT_TOKEN) {
    try {
      const base = 'https://api.telegram.org/bot' + String(env.TELEGRAM_BOT_TOKEN).trim() + '/';
      const me = await (await fetch(base + 'getMe')).json();
      r.Telegram_bot = me.ok ? 'ok (@' + me.result.username + ')' : 'TOKEN RECUSADO pelo Telegram: ' + String(me.description || '').slice(0, 60);
      if (me.ok) {
        const w = await (await fetch(base + 'getWebhookInfo')).json();
        const i = w.result || {};
        r.Telegram_webhook = { ligado_a: i.url || 'NENHUM (falta fazer o setWebhook)', mensagens_na_fila: i.pending_update_count || 0, ultimo_erro: i.last_error_message || 'nenhum' };
      }
    } catch (e) { r.Telegram_bot = 'não consegui falar com o Telegram'; }
  }
  return json(r);
}

/* ------------------------------------------------------------------ roteamento */

export default {
  async fetch(req, env) {
    const url = new URL(req.url), cors = corsHeaders(req, env);
    if (req.method === 'OPTIONS') return new Response(null, { status: 204, headers: cors });
    try {
      const p = url.pathname, m = req.method;
      let res;
      if (p === '/diagnostico' && m === 'GET') res = await diagnostico(env);
      else if (!env.GUIA_KV && p !== '/') res = json({ erro: 'kv_nao_ligado', motivo: MOTIVOS.kv_nao_ligado }, 503);
      else if (p === '/telegram/webhook' && m === 'POST') res = await webhook(req, env);
      else if (p === '/vinculo/novo' && m === 'POST') res = await vinculoNovo(req, env);
      else if (p === '/vinculo/buscar' && m === 'POST') res = await vinculoBuscar(req, env);
      else if (p === '/vinculo/status' && m === 'GET') res = await vinculoStatus(url, env);
      else if (p === '/alerta' && m === 'POST') res = await alerta(req, env);
      else if (p === '/previsao' && m === 'GET') res = await previsao(url, env);
      else if (p === '/linha' && m === 'GET') res = await linhaInfo(env);
      else if (p === '/paradas' && m === 'GET') res = await paradasInfo(env);
      else if (p === '/' && m === 'GET') res = json({ ok: true, servico: 'guia-api', bot: '@' + (env.BOT_USERNAME || '') });
      else res = json({ erro: 'nao_encontrado' }, 404);
      return comCors(res, cors);
    } catch (e) {
      return comCors(json({ erro: 'interno' }, 500), cors);
    }
  }
};
